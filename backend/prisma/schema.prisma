generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  role            String    @default("ADMIN")
  login           String    @unique
  passwordHash    String
  fullName        String
  phone           String?
  isActive        Boolean   @default(true)
  mustChangePw    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?
  sessions        Session[]
  taughtGroups    Group[]   @relation("GroupTeacher")
  markedAttendance Attendance[] @relation("AttendanceMarker")
  gradedGrades    Grade[]   @relation("GradeMarker")
  paymentsCreated Payment[] @relation("PaymentCreator")
  auditLogs       AuditLog[]
}

model Student {
  id          String        @id @default(cuid())
  studentCode String        @unique
  firstName   String
  lastName    String
  phone       String?
  address     String?
  status      String        @default("ACTIVE")
  groupId     String?
  group       Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  enrolledAt  DateTime      @default(now())
  notes       String?
  createdAt   DateTime      @default(now())
  parents     Parent[]
  attendance  Attendance[]
  grades      Grade[]
  payments    Payment[]
  paymentPlan PaymentPlan?
}

model Parent {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relation  String
  fullName  String
  phone     String
}

model Group {
  id           String   @id @default(cuid())
  name         String
  teacherId    String?
  teacher      User?    @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  scheduleText String?
  startDate    DateTime @default(now())
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  students     Student[]
  lessons      Lesson[]
}

model Lesson {
  id           String       @id @default(cuid())
  groupId      String
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date         DateTime
  topic        String?
  isCancelled  Boolean      @default(false)
  cancelReason String?
  attendance   Attendance[]
  grades       Grade[]
}

model Attendance {
  id         String   @id @default(cuid())
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     String
  markedById String
  markedBy   User     @relation("AttendanceMarker", fields: [markedById], references: [id])
  markedAt   DateTime @default(now())

  @@unique([lessonId, studentId])
}

model Grade {
  id         String   @id @default(cuid())
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score      Int
  comment    String?
  gradedById String
  gradedBy   User     @relation("GradeMarker", fields: [gradedById], references: [id])
  gradedAt   DateTime @default(now())

  @@unique([lessonId, studentId])
}

model Payment {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Float
  paidAt      DateTime @default(now())
  periodMonth String
  method      String   @default("CASH")
  comment     String?
  createdById String
  createdBy   User     @relation("PaymentCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model PaymentPlan {
  id              String   @id @default(cuid())
  studentId       String   @unique
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  monthlyFee      Float
  startDate       DateTime @default(now())
  discountPercent Int      @default(0)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  ip         String?
  createdAt  DateTime @default(now())
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  ip               String?
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  login     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())
}
